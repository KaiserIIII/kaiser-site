---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroChapter from '../components/HeroChapter.astro';
import JourneyChapter from '../components/JourneyChapter.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SignalsChapter from '../components/SignalsChapter.astro';
import ContactChapter from '../components/ContactChapter.astro';
---

<SiteLayout title="KAISER / Yue Yu" description="Making complex ideas visible through working systems.">
  <div class="site-shell">
    <SiteHeader />

    <main id="profile" class="site-main">
      <HeroChapter />
      <JourneyChapter />
      <ProjectGrid />
      <SignalsChapter />
      <ContactChapter />
    </main>

    <footer class="site-footer"><span>© {new Date().getFullYear()} KAISER / YUE YU</span><span>BUILT LOCALLY · SHIPPED CAREFULLY</span></footer>
  </div>
</SiteLayout>
