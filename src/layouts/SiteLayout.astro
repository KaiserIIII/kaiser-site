---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KAISER',
  description = 'Kaiser / 于越 — personal portfolio and digital profile.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#profile">Skip to content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="ambient-orbit ambient-orbit--one" aria-hidden="true"></div>
    <div class="ambient-orbit ambient-orbit--two" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
